    /* Oogie (KNOWN_ISSUES #48): RECOMP_APU_BINS=1 logs each change of a
     * voice's mixbins, volumes or stereo flag. */
    {
        static int on = -1;
        static uint64_t last[MCPX_HW_MAX_VOICES];
        static unsigned lines;
        static int64_t t0;
        if (!t0) t0 = qemu_clock_get_us(QEMU_CLOCK_REALTIME);
        if (on < 0) { const char *e = getenv("RECOMP_APU_BINS"); on = e && *e && *e != '0'; }
        if (on && lines < 40000) {
            uint64_t h = 1469598103934665603ull ^ (uint64_t)stereo;
            for (int b = 0; b < 8; b++) {
                h = (h ^ (uint64_t)bin[b]) * 1099511628211ull;
                h = (h ^ (uint64_t)vol[b]) * 1099511628211ull;
            }
            if (h != last[v]) {
                last[v] = h;
                lines++;
                fprintf(stderr, "[APU-ROUTE] ms=%u v=%u st=%d bins=%d,%d,%d,%d,%d,%d,%d,%d"
                        " vol=%03X,%03X,%03X,%03X,%03X,%03X,%03X,%03X ea=%.2f\n",
                        (unsigned)((qemu_clock_get_us(QEMU_CLOCK_REALTIME) - t0) / 1000), v, (int)stereo, bin[0], bin[1], bin[2], bin[3],
                        bin[4], bin[5], bin[6], bin[7], vol[0], vol[1], vol[2],
                        vol[3], vol[4], vol[5], vol[6], vol[7], ea_value);
            }
        }
    }

    if (voice_should_mute(v)) return;
