/* Oogie patch (port/patches/pb_segment_carry, KNOWN_ISSUES #46): two ways
 * the segment scan lost commands.
 *
 * 1. A method whose parameters ran past PUT: the loop stopped at end_va and
 *    the rest of the parameters were forgotten; the next segment then started
 *    at PUT and read those parameters as command headers. D3D streams large
 *    inline arrays across kicks (see s_pend_left in the DMA walk), so this
 *    happened in play. The remainder is now carried to the next top-level
 *    segment, as the DMA walk does.
 * 2. The ring's wrap: the caller scanned the old piece only up to the highest
 *    PUT seen so far, so commands written past it before D3D's JUMP back to
 *    the ring start were never executed (a missed SET_TRANSFORM_PROGRAM_START
 *    drew the whole scene with the overlay program: the white frames; a
 *    missed draw: the dark ones). A top-level walk that ends on a JUMP now
 *    records its target, and nv2a_pb_scan_segment_wrap walks the old piece
 *    to that JUMP and reports where the ring continues. */
static uint32_t s_sg_left, s_sg_i, s_sg_method, s_sg_subch;
static int s_sg_noninc;
static uint32_t s_sg_jump;              /* VA the last top-level walk jumped to, 0: none */

/* OOGIE_PB_CARRY_OLD=1: drop the rest of a cut method, as before (A/B). */
static int pb_carry_off(void)
{
    static int off = -1;
    if (off < 0) { const char *e = getenv("OOGIE_PB_CARRY_OLD"); off = e && *e && *e != '0'; }
    return off;
}

static uint32_t pb_walk_segment(uint32_t va, uint32_t end_va, int in_call,
                                uint32_t *jumps, uint32_t *unknown)
{
    const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
    uint32_t words = 0;

    if (!in_call) {
        s_sg_jump = 0;
        /* the parameters of the method the previous segment stopped inside */
        while (s_sg_left && va < end_va && (va & 0x0FFFFFFFu) + 4u <= PB_RAM_BYTES) {
            uint32_t m = s_sg_noninc ? s_sg_method : s_sg_method + s_sg_i * 4;
            note(s_sg_subch, m);
            if (s_exec_enabled)
                nv2a_pb_exec_method(s_sg_subch, m, *(const uint32_t *)(mem + va));
            va += 4;
            words++;
            s_sg_i++;
            s_sg_left--;
        }
    }
    while (va < end_va && words < 0x100000u) {
        uint32_t w;
        /* pb_segment_bounds: stop at the end of the contiguous window
         * (KNOWN_ISSUES #28). */
        if ((va & 0x0FFFFFFFu) + 4u > PB_RAM_BYTES)
            break;
        w = *(const uint32_t *)(mem + va);
        va += 4;
        words++;
        /* pb_segment_ack: keep answering kickoffs while executing. */
        if (s_exec_enabled && (++s_ack_tick & 0xFFu) == 0)
            xbox_Nv2aAckBusyBits();

        if ((w & 3u) == 1u || (w & 0xE0000003u) == 0x20000000u) {
            uint32_t target = (w & 3u) == 1u ? (w & 0xFFFFFFFCu)
                                             : (w & 0x1FFFFFFCu);
            (*jumps)++;
            if (!in_call) {
                s_sg_jump = 0x80000000u | (target & 0x0FFFFFFFu);
                break;                        /* the ring: a jump ends it */
            }
            va = 0x80000000u | (target & 0x0FFFFFFFu);
            end_va = va + 0x400000u;
            continue;
        }
        if ((w & 0xFFFF0003u) == 0x00020000u) {  /* RETURN */
            if (in_call)
                break;
            continue;
        }
        if ((w & 3u) == 2u) {                    /* CALL */
            if (!in_call) {
                uint32_t sub = 0x80000000u | ((w & 0xFFFFFFFCu) & 0x0FFFFFFFu);
                s_tot_calls++;
                words += pb_walk_segment(sub, sub + 0x400000u, 1, jumps, unknown);
            }
            continue;
        }
        if ((w & 0x00030003u) == 0u) {
            uint32_t count  = (w >> 18) & 0x7FFu;
            uint32_t subch  = (w >> 13) & 7u;
            uint32_t method =  w & 0x1FFCu;
            int noninc = (w & 0xE0000000u) == 0x40000000u;
            uint32_t i;

            for (i = 0; i < count && va < end_va
                        && (va & 0x0FFFFFFFu) + 4u <= PB_RAM_BYTES; i++) {
                uint32_t m = noninc ? method : method + i * 4;
                note(subch, m);
                if (s_exec_enabled)
                    nv2a_pb_exec_method(subch, m,
                                        *(const uint32_t *)(mem + va));
                va += 4;
                words++;
            }
            if (!in_call && i < count && !pb_carry_off()) {  /* PUT came first: finish it next time */
                s_sg_left = count - i;
                s_sg_i = i;
                s_sg_method = method;
                s_sg_subch = subch;
                s_sg_noninc = noninc;
            }
            continue;
        }
        (*unknown)++;
    }
    return words;
}

void nv2a_pb_scan_segment(uint32_t start_va, uint32_t end_va)
{
    uint32_t words, jumps = 0, unknown = 0;

    if (!pb_walk_enabled() || end_va <= start_va)
        return;
    if (end_va - start_va > 0x400000u)        /* a sane single-frame bound */
        end_va = start_va + 0x400000u;

    words = pb_walk_segment(start_va, end_va, 0, &jumps, &unknown);

    s_tot_words += words;
    s_tot_unknown += unknown;
    s_tot_jumps += jumps;
    s_tot_segments++;
}

/* The ring wrapped (PUT moved below its old value): walk from the old PUT to
 * D3D's JUMP back to the ring start and return the JUMP's target (a VA), or 0
 * when no JUMP was found within the bound. */
uint32_t nv2a_pb_scan_segment_wrap(uint32_t start_va)
{
    uint32_t words, jumps = 0, unknown = 0;

    if (!pb_walk_enabled())
        return 0;
    words = pb_walk_segment(start_va, start_va + 0x400000u, 0, &jumps, &unknown);
    s_tot_words += words;
    s_tot_unknown += unknown;
    s_tot_jumps += jumps;
    s_tot_segments++;
    return s_sg_jump;
}
