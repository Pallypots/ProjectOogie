    /* Oogie (2026-10-23): "logged++ < 20" on a plain int wrapped after 2^31
     * calls, and from then on every call was logged: the owner's 15-hour
     * session wrote a 10 GB play.log of this one line. The count now stops
     * at 20. Also, a wait called more than 10 000 times a second (a polling
     * loop) is reported every 10 s with its handle, timeout and the guest
     * stack words around the call, to find the poller. */
    static volatile LONG logged = 0;
    static volatile LONG win_calls = 0, reports = 0;
    static volatile ULONGLONG win_t0 = 0;
    if (logged < 20 && InterlockedIncrement(&logged) <= 20) {
        fprintf(stderr, "  [KERNEL] NtWaitForSingleObjectEx: token=0x%08X "
                "handle=%p timeout=%s\n",
                STACK_ARG(0), handle, timeout_ptr ? "finite" : "INFINITE");
        fflush(stderr);
    }
    {
        ULONGLONG now = GetTickCount64();
        LONG n = InterlockedIncrement(&win_calls);
        if (!win_t0) win_t0 = now;
        if (now - win_t0 >= 10000) {
            win_t0 = now;
            InterlockedExchange(&win_calls, 0);
            if (n > 100000 && reports < 50) {
                double ms = 0;
                InterlockedIncrement(&reports);
                if (timeout_ptr)
                    ms = (double)(-(int64_t)((uint64_t)BRIDGE_MEM32(timeout_ptr) |
                                             ((uint64_t)BRIDGE_MEM32(timeout_ptr + 4) << 32))) / 10000.0;
                fprintf(stderr, "  [KERNEL] NtWaitForSingleObjectEx polled %ld times in 10 s: token=0x%08X "
                        "timeout=%s%.3f ms, stack %08X %08X | %08X %08X %08X %08X %08X %08X %08X %08X\n",
                        (long)n, STACK_ARG(0), timeout_ptr ? "" : "INFINITE ", ms,
                        (uint32_t)BRIDGE_MEM32(g_esp - 8), (uint32_t)BRIDGE_MEM32(g_esp - 4),
                        STACK_ARG(4), STACK_ARG(5), STACK_ARG(6), STACK_ARG(7),
                        STACK_ARG(8), STACK_ARG(9), STACK_ARG(10), STACK_ARG(11));
                fflush(stderr);
            }
        }
    }
