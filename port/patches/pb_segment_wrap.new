                        } else if (last_put && put < last_put) {
                            /* Oogie patch (port/patches/pb_segment_wrap,
                             * KNOWN_ISSUES #46): follow D3D's own JUMP at the
                             * ring's end instead of stopping at the highest
                             * PUT seen so far (commands past it were lost),
                             * and continue from the JUMP's target. The old
                             * guess (put_lo) only when no JUMP was found.
                             * OOGIE_PB_WRAP_OLD=1: the old behaviour. */
                            extern uint32_t nv2a_pb_scan_segment_wrap(uint32_t);
                            static int old_wrap = -1;
                            if (old_wrap < 0) {
                                const char *e = getenv("OOGIE_PB_WRAP_OLD");
                                old_wrap = e && *e && *e != '0';
                            }
                            if (old_wrap) {
                                if (put_hi > last_put)
                                    nv2a_pb_scan_segment(
                                        XBOX_CONTIG_BASE | (last_put & 0x0FFFFFFFu),
                                        XBOX_CONTIG_BASE | (put_hi   & 0x0FFFFFFFu));
                                if (put > put_lo)
                                    nv2a_pb_scan_segment(
                                        XBOX_CONTIG_BASE | (put_lo & 0x0FFFFFFFu),
                                        XBOX_CONTIG_BASE | (put    & 0x0FFFFFFFu));
                            } else {
                                uint32_t start = nv2a_pb_scan_segment_wrap(
                                    XBOX_CONTIG_BASE | (last_put & 0x0FFFFFFFu));
                                uint32_t endv = XBOX_CONTIG_BASE | (put & 0x0FFFFFFFu);
                                static unsigned wraps, misses;
                                wraps++;
                                if (!start) {
                                    start = XBOX_CONTIG_BASE | (put_lo & 0x0FFFFFFFu);
                                    if (misses++ < 5)
                                        fprintf(stderr, "  [NV2A] ring wrap without a JUMP"
                                                " (old PUT 0x%08X, new 0x%08X); guessing 0x%08X\n",
                                                last_put, put, start);
                                }
                                if (endv > start)
                                    nv2a_pb_scan_segment(start, endv);
                            }
                        }
